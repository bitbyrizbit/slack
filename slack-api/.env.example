# Database Connection URL (Pure PostgreSQL)
# Format: postgresql://[user[:password]@][host][:port][/dbname]
DATABASE_URL=postgresql://postgres:2006@localhost:5432/slack_db

# Engine Configuration
TIGHT_THRESHOLD_MINUTES=30
DEBUG=false

# Groq LLM API Key (Optional, for LLM-enriched recovery explanations)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
